# Copy this to .env and fill in your values
# Never commit .env to git!

# Gemini API Key for AI Tutor serverless function
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model used by the AI Tutor
GEMINI_MODEL=gemini-3.5-flash-lite

# Set to true only after AI Tutor privacy and abuse controls are ready
AI_TUTOR_ENABLED=false

# Required in production: exact IP of the reverse proxy connected directly to Node.
AI_TUTOR_TRUSTED_PROXY_IP=your_reverse_proxy_ip

# Local dev only; Vite's serve-only plugin sets this automatically.
AI_TUTOR_DEV_RATE_LIMIT=memory

# Copy this to .env and fill in your values
# Never commit .env to git!

# Gemini API Key for AI Tutor serverless function
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model used by the AI Tutor
GEMINI_MODEL=gemini-2.5-flash

# Set to true only after AI Tutor privacy and abuse controls are ready
AI_TUTOR_ENABLED=false

# Required in production: Upstash Redis REST database credentials.
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Optional for local npm run dev only; never used unless NODE_ENV is development.
AI_TUTOR_DEV_RATE_LIMIT=memory
